
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=0

# Security
SECRET_KEY=replace_with_your_own_secret_key

# MySQL Database
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/hotelreservationdb

# Hotel Details
HOTEL_NAME=Grand Haven Hotel
HOTEL_EMAIL=your_hotel_email@example.com
HOTEL_PHONE=
HOTEL_ADDRESS=

# Regional Settings
HOTEL_TIMEZONE=Asia/Kolkata
HOTEL_CURRENCY=INR
HOTEL_TAX_RATE=0.12

# Reservation Settings
DEFAULT_CHECKIN_TIME=15:00
DEFAULT_CHECKOUT_TIME=11:00
CANCELLATION_DEADLINE_DAYS=2
